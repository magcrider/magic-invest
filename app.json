{
  "expo": {
    "name": "Magic Invest",
    "slug": "magic-invest",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/magic-invest-icon.png",
    "scheme": "magicinvest",
    "userInterfaceStyle": "automatic",
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#5B8E8E",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.anonymous.magicinvest"
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#5B8E8E",
          "android": {
            "image": "./assets/images/hat-mark.png",
            "imageWidth": 200
          }
        }
      ],
      "expo-sqlite"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "fac84751-8709-444d-8cbe-a4553c84f200"
      }
    },
    "owner": "ey.magic"
  }
}
